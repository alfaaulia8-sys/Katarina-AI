{
  "schema_version": 1,
  "connection_id": "katarina-unified",
  "transport": "github-private-repository",
  "repository": "alfaaulia8-sys/Katarina-VPS-Control",
  "branch": "main",
  "poll_seconds": 180,
  "paths": {
    "jobs": "jobs",
    "results": "results",
    "status": "status"
  },
  "devices": {
    "vps": {
      "target": "vps",
      "runtime": "windows-powershell",
      "agent": "agent/KatarinaVPSAgent.ps1",
      "status_file": "status/vps.json",
      "enabled": true
    },
    "termux": {
      "target": "termux",
      "runtime": "android-termux-python",
      "agent": "agent/TermuxAgent.py",
      "status_file": "status/termux.json",
      "enabled": true,
      "browser": {
        "port": 9222,
        "read_only_probe": true,
        "bind": "127.0.0.1",
        "automation": "playwright-core",
        "ready": false,
        "access": "adb-forwarded-chrome-devtools"
      }
    }
  },
  "safety": {
    "no_secrets_in_repository": true,
    "no_arbitrary_shell_jobs": true,
    "actions_are_allowlisted": true,
    "no_unauthorized_website_bidding": true,
    "chrome_debugging_local_only": true
  },
  "heartbeat_seconds": 300,
  "data_policy": {
    "profile_path": "profiles/registration-profile.json",
    "site_registry_path": "profiles/site-registry.json",
    "secrets_in_repo": false,
    "personal_docs_plaintext_in_repo": false
  }
}
