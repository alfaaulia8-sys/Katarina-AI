{
  "schema_version": 1,
  "name": "KATARINA_CAPITAL_COMPOUNDING_V1",
  "trigger_basis": "BROKER_REALIZED_BALANCE",
  "floating_equity_can_trigger_milestone": false,
  "reserve_fraction": 0.30,
  "active_fraction_at_milestone": 0.70,
  "growth_multiple": 2.0,
  "next_target_formula": "active_balance * 2",
  "risk_basis": "MIN(active_trading_balance,current_equity)",
  "withdrawal_policy": {
    "consume_reserve_first": true,
    "withdrawal_within_reserve_changes_active_balance": false,
    "withdrawal_exceeding_reserve_rebases_active_balance": true,
    "next_target_recalculated_only_when_active_capital_is_consumed": true
  },
  "deposit_policy": {
    "external_deposit_is_not_profit": true,
    "deposit_increases_active_capital": true,
    "deposit_rebases_next_target": true
  },
  "reserve_used_for_position_sizing": false,
  "persist_across_restart": true
}
