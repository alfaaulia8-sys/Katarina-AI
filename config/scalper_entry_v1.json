{
  "schema_version": 2,
  "name": "KATARINA_MULTI_MARKET_SCALPER_ENTRY_V2",
  "symbol_scope": "BROKER_TRADABLE_UNIVERSE",
  "asset_classes": ["FOREX","METAL","ENERGY","INDEX","CRYPTO","OTHER"],
  "routing": {
    "TREND_UP": "TREND_PULLBACK",
    "TREND_DOWN": "TREND_PULLBACK",
    "RANGE": "RANGE_MEAN_REVERSION",
    "HIGH_VOL": "MOMENTUM_BREAKOUT",
    "UNKNOWN": "NO_TRADE"
  },
  "market_selection": {
    "rank_across_symbols": true,
    "require_broker_session_open": true,
    "require_fresh_tick": true,
    "require_news_context": true,
    "apply_correlation_penalty": true,
    "select_best_opportunity_not_fixed_symbol": true
  },
  "risk_authority": "NONE",
  "entry_defaults": {
    "max_spread_bps": 3.0,
    "momentum_max_spread_bps": 4.0,
    "instrument_specific_spread_override": true,
    "instrument_specific_session_override": true,
    "min_mtf_alignment": 0.55,
    "min_trend_adx": 20.0,
    "min_momentum_adx": 25.0,
    "trend_rr": 2.2,
    "trend_stop_atr_mult": 1.3,
    "range_stop_atr_mult": 1.2,
    "range_min_rr": 0.8,
    "range_max_adx": 24.0,
    "momentum_min_body_atr": 0.8,
    "momentum_min_velocity": 0.35,
    "momentum_min_imbalance": 0.15,
    "momentum_rr": 1.8,
    "momentum_stop_atr_mult": 1.0
  },
  "hard_gates": [
    "fresh_data",
    "broker_session_open",
    "news_context",
    "news_blackout",
    "spread",
    "valid_regime",
    "higher_timeframe_conflict",
    "portfolio_correlation"
  ],
  "live_risk_authorized": false
}
