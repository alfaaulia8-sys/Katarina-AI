{
  "schema_version": 1,
  "status": "ACTIVE_DRAFT",
  "purpose": "CHATGPT_MEDIATED_VPS_TEST_AND_TELEMETRY_BRIDGE",
  "security_model": {
    "inbound_ports_required": false,
    "outbound_https_only": true,
    "arbitrary_shell_from_request_allowed": false,
    "allowed_tasks_only": true,
    "production_broker_mutation_allowed": false,
    "secrets_in_requests_allowed": false,
    "secrets_in_results_allowed": false,
    "max_text_result_bytes": 1048576
  },
  "request": {
    "required_fields": [
      "schema_version",
      "request_id",
      "target_agent",
      "task",
      "created_utc",
      "expires_utc"
    ],
    "optional_fields": [
      "ref",
      "args"
    ],
    "default_ref": "main",
    "target_must_match_agent_id": true,
    "directories": {
      "legacy": "ops/vps/requests/legacy",
      "github_actions": "ops/vps/requests/actions"
    }
  },
  "result": {
    "directory": "ops/vps/results",
    "allowed_extensions": [
      ".json",
      ".txt",
      ".log",
      ".csv",
      ".md"
    ],
    "binary_upload_to_repo": false
  },
  "allowed_tasks": {
    "HOST_INVENTORY": {
      "risk": "READ_ONLY",
      "workspace_required": false
    },
    "REPO_STATIC_TESTS": {
      "risk": "READ_ONLY",
      "workspace_required": true
    },
    "STAGE06_HOST_CHECK": {
      "risk": "READ_ONLY",
      "workspace_required": true
    },
    "STAGE06_COMPILE_PROOF": {
      "risk": "READ_ONLY_BUILD",
      "workspace_required": true
    },
    "STAGE06_CLEARANCE": {
      "risk": "READ_ONLY_BUILD_AND_MT5_EVIDENCE",
      "workspace_required": true
    },
    "STAGE07_PYTHON_TESTS": {
      "risk": "READ_ONLY",
      "workspace_required": true
    },
    "COLLECT_MT5_LOGS": {
      "risk": "READ_ONLY",
      "workspace_required": false
    },
    "STAGE06_RUNTIME_PROBE": {
      "risk": "READ_ONLY_MT5_RUNTIME",
      "workspace_required": true
    }
  },
  "modern_windows": {
    "preferred_bridge": "GITHUB_ACTIONS_SELF_HOSTED_RUNNER",
    "supported_baseline": [
      "WINDOWS_11_X64",
      "WINDOWS_SERVER_2022_X64"
    ],
    "compatibility": [
      "WINDOWS_10_X64",
      "WINDOWS_SERVER_2016_X64",
      "WINDOWS_SERVER_2019_X64"
    ],
    "runner_labels": [
      "self-hosted",
      "windows",
      "x64",
      "katarina-vps"
    ]
  },
  "windows_server_2012_r2": {
    "github_actions_self_hosted_runner_supported": false,
    "bridge": "KATARINA_LEGACY_VPS_AGENT",
    "transport": "GITHUB_CONTENTS_API_HTTPS",
    "execution_model": "POLL_ALLOWLISTED_REQUESTS_WRITE_TEXT_RESULTS",
    "note": "Used only as an operations bridge; official GitHub Actions runner support starts at Windows Server 2016."
  }
}
