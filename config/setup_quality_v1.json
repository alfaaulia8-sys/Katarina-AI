{
  "schema_version": 1,
  "name": "KATARINA_SETUP_QUALITY_V1",
  "policy": {
    "literature_is_prior_not_performance_proof": true,
    "quality_layer_can_only_reduce_requested_risk": true,
    "real_tick_validation_required": true,
    "walk_forward_required": true,
    "monte_carlo_required": true
  },
  "quality": {
    "minimum_adjusted_score": 0.62,
    "minimum_liquidity": 0.35,
    "minimum_atr_ratio": 0.45,
    "maximum_atr_ratio": 2.75,
    "risk_multipliers": {
      "high_quality": 1.0,
      "medium_quality": 0.75,
      "minimum_quality": 0.5
    }
  },
  "source_consensus": {
    "single_official_source_can_be_authoritative": true,
    "nonofficial_minimum_independent_sources": 2,
    "conflicting_sources_reduce_consensus": true
  }
}
