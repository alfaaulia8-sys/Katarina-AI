#property strict
#property script_show_inputs

#include <Katarina/Stage07/Kat1Codec.mqh>

#define KAT_STAGE07_VECTOR_COUNT 13

void KatStage07WriteEvidence(const int failures)
  {
   const int handle=FileOpen("Katarina_Stage07_kat1_codec_result.txt",
                             FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_COMMON);
   if(handle==INVALID_HANDLE)
      return;

   FileWrite(handle,"schema_version=1.0");
   FileWrite(handle,"stage=07");
   FileWrite(handle,"proof_type=MQL5_KAT1_GOLDEN_CONFORMANCE");
   FileWrite(handle,"terminal_build="+IntegerToString((int)TerminalInfoInteger(TERMINAL_BUILD)));
   FileWrite(handle,"vectors="+IntegerToString(KAT_STAGE07_VECTOR_COUNT));
   FileWrite(handle,"failures="+IntegerToString(failures));
   FileWrite(handle,(failures==0 ? "result=PASS" : "result=FAIL"));
   FileClose(handle);
  }

void OnStart(void)
  {
   string names[KAT_STAGE07_VECTOR_COUNT]=
     {
      "HELLO",
      "HELLO_ACK_USD",
      "HELLO_ACK_USC",
      "TICK_EVENT_XAUUSD",
      "BAR_EVENT_M1",
      "ACCOUNT_DELTA_STANDARD_LIKE",
      "ACCOUNT_DELTA_CENT_LIKE",
      "OPEN_INTENT_MARKET",
      "OPEN_INTENT_LIMIT",
      "OPEN_INTENT_STOP",
      "ACCOUNT_LEDGER_WITHDRAWAL",
      "BROKER_CALC_REPORT",
      "TRADE_EVENT_FILLED"
     };

   string hexes[KAT_STAGE07_VECTOR_COUNT]=
     {
      "4b4154310100340001000100340003006c000000010000000000000000000000000000000807060504030201181716151413121100112233445566778899aabbccddeeff3f0000000000000000000000000000000000000000000000000100000000000000000000b5861ead",
      "",
      "",
      "4b415431010034006400010030000100680000006400000000000000c0d46687b8c1da180807060504030201181716151413121101000000070000005b8a060000000000688a0600000000000000000000000000000000000000000000000000030000006c56d517",
      "4b41543101003400650001005000010088000000650000000000000000585978c6c1da1808070605040302011817161514131211010000000700000001000000d204000000001280b8c1da18d4890600000000009c8a06000000000070890600000000005b8a060000000000db0300000000000000000000000000000f00000001000000769254c6",
      "",
      "",
      "",
      "",
      "",
      "4b41543101003400cb0001004000030084000000d20000000000000000d0ff10e7c1da1808070605040302011817161514131211ffeeddccbbaa99887766554433221100591b00000000000000d0ff10e7c1da1878ecffffffffffff0202000002000000000000003800000000000000000000000a007769746864726177616ca11d11c8",
      "4b41543101003400410101004800030080000000dc0000000000000000443bb5f2c1da180807060504030201181716151413121112121212121212121212121212121212ffeeddccbbaa99887766554433221100010000000700000024fafffffffffffff4010000000000000101000000000000090000000000000010d6a7ca",
      ""
     };

   ushort expected_types[KAT_STAGE07_VECTOR_COUNT]=
     {
      1,
      2,
      2,
      100,
      101,
      200,
      200,
      300,
      300,
      300,
      203,
      321,
      311
     };

   uint expected_lengths[KAT_STAGE07_VECTOR_COUNT]=
     {
      108,
      178,
      178,
      104,
      136,
      200,
      200,
      288,
      288,
      288,
      132,
      128,
      216
     };

   int failures=0;

   for(int i=0;i<KAT_STAGE07_VECTOR_COUNT;i++)
     {
      uchar frame[];
      string error="";
      if(!Kat1HexToBytes(hexes[i],frame,error))
        {
         PrintFormat("FAIL %s hex decode: %s",names[i],error);
         failures++;
         continue;
        }

      SKat1Header header;
      if(!Kat1ValidateFrame(frame,header,error))
        {
         PrintFormat("FAIL %s frame validate: %s",names[i],error);
         failures++;
         continue;
        }

      if(header.message_type!=expected_types[i])
        {
         PrintFormat("FAIL %s message type expected=%u actual=%u",
                     names[i],expected_types[i],header.message_type);
         failures++;
        }

      if(header.frame_length!=expected_lengths[i])
        {
         PrintFormat("FAIL %s frame length expected=%u actual=%u",
                     names[i],expected_lengths[i],header.frame_length);
         failures++;
        }

      uchar encoded_header[];
      if(!Kat1EncodeHeader(header,encoded_header,error))
        {
         PrintFormat("FAIL %s header encode: %s",names[i],error);
         failures++;
        }
      else if(!Kat1HeaderBytesEqual(frame,encoded_header))
        {
         PrintFormat("FAIL %s header byte equality",names[i]);
         failures++;
        }
      else
         PrintFormat("PASS %s",names[i]);
     }

   // Corrupt one covered payload byte in the first golden fixture.
   uchar base[];
   string base_error="";
   if(Kat1HexToBytes(hexes[0],base,base_error))
     {
      uchar corrupt[];
      ArrayCopy(corrupt,base,0,0,WHOLE_ARRAY);
      if(ArraySize(corrupt)>60)
         corrupt[60]^=0x01;

      SKat1Header bad_header;
      string bad_error="";
      if(Kat1ValidateFrame(corrupt,bad_header,bad_error))
        {
         Print("FAIL corruption rejection: CRC mutation was accepted");
         failures++;
        }
      else
         PrintFormat("PASS corruption rejection: %s",bad_error);
     }
   else
     {
      PrintFormat("FAIL corruption fixture setup: %s",base_error);
      failures++;
     }

   // Corrupt magic independently.
   if(ArraySize(base)>=4)
     {
      uchar bad_magic[];
      ArrayCopy(bad_magic,base,0,0,WHOLE_ARRAY);
      bad_magic[0]^=0x01;

      SKat1Header magic_header;
      string magic_error="";
      if(Kat1ValidateFrame(bad_magic,magic_header,magic_error))
        {
         Print("FAIL magic rejection: invalid magic was accepted");
         failures++;
        }
      else
         PrintFormat("PASS magic rejection: %s",magic_error);
     }

   KatStage07WriteEvidence(failures);

   if(failures==0)
      Print("Katarina Stage 07 MQL5 KAT1 golden conformance PASSED");
   else
      PrintFormat("Katarina Stage 07 MQL5 KAT1 golden conformance FAILED: %d",failures);

   if(MQLInfoInteger(MQL_STARTED_FROM_CONFIG))
      TerminalClose(failures==0 ? 0 : 7);
  }
